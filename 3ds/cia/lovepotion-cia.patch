 bool Filesystem::GetRealPathType(const std::string& path, FileType& type) const
 {
-    if (!std::filesystem::exists(path))
+    std::error_code error;
+    auto status = std::filesystem::status(path, error);
+    if (error || !std::filesystem::exists(status))
         return false;
 
-    if (std::filesystem::is_regular_file(path))
+    if (std::filesystem::is_regular_file(status))
         type = FILETYPE_FILE;
-    else if (std::filesystem::is_directory(path))
+    else if (std::filesystem::is_directory(status))
         type = FILETYPE_DIRECTORY;
-    else if (std::filesystem::is_symlink(path))
+    else if (std::filesystem::is_symlink(std::filesystem::symlink_status(path, error)))
         type = FILETYPE_SYMLINK;
     else
         type = FILETYPE_OTHER;
@@ -51,7 +53,8 @@ bool Filesystem::CreateRealDirectory(const std::string& path)
     if (this->GetRealPathType(path, type))
         return type == FileType::FILETYPE_DIRECTORY;
 
-    return std::filesystem::create_directories(path);
+    std::error_code error;
+    return std::filesystem::create_directories(path, error);
 }
 
